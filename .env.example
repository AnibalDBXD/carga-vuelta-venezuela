# Local Supabase (bun run db:start) — copy values from `bunx supabase status -o env`
# Hosted: Project Settings → API (https://<ref>.supabase.co)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=your-local-publishable-or-anon-key
SUPABASE_SECRET_KEY=your-local-secret-or-service-role-key
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=your-local-publishable-or-anon-key

# Public URL of the app; links in emails and notifications use it.
APP_URL=http://localhost:5173

# Mapbox (optional). Without a token: estimated routes and "Mapa no disponible".
# VITE_MAPBOX_TOKEN is used in the browser (pk...); MAPBOX_TOKEN on the server.
VITE_MAPBOX_TOKEN=
MAPBOX_TOKEN=

# Web Push (VAPID) — `bunx web-push generate-vapid-keys`
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Email: SMTP_URL for a real provider; MAILPIT_URL delivers to local Mailpit inbox.
SMTP_URL=
MAILPIT_URL=http://127.0.0.1:54324

# Fallback USD/VES rate if bcv.org.ve is unreachable and there is no cached rate.
BCV_FALLBACK_RATE=  # fija la tasa (demo); vacío = consulta bcv.org.ve

# Platform pago móvil shown to payers (the company collects, then pays drivers).
PAGO_MOVIL_BANK=
PAGO_MOVIL_PHONE=
PAGO_MOVIL_DOCUMENT=
PAGO_MOVIL_HOLDER=

# Telegram bot (spec: specs/003-telegram.md). Token de @BotFather; el username
# público arma los deep-links t.me/<bot>?start=... en la web. El secreto
# valida que los updates del webhook vengan de Telegram (`bun run bot:setup`).
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
VITE_TELEGRAM_BOT=

# Asistente IA del bot (Gemini API free tier, aistudio.google.com/apikey).
# Opcionalmente cambia los modelos: texto/visión default gemini-3.1-flash-lite-preview.
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_VISION_MODEL=
